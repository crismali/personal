{
  "name": "personal",
  "version": "1.0.0",
  "scripts": {
    "clean": "bun run clean:dev && bun run clean:build",
    "clean:dev": "rm -rf src/_dist",
    "clean:build": "rm -rf dist",
    "dev": "bun run dev.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "ci": "bun run typecheck && bun run format:check && bun run test && bun run build",
    "preview": "bun run build && bunx serve dist/ --listen ${PORT:-3000}"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "^0.35.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/sharp": "^0.32.0",
    "happy-dom": "^20.11.1",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "typescript": "7"
  }
}
